
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #263238;
    line-height: 1.7;
}

header {
    background: #14213d;
    padding: 18px 8%;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    color: white;
    font-size: 25px;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 18px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

nav a:hover {
    color: #fca311;
}

.hero {
    text-align: center;
    padding: 110px 20px;
    background: #e5efff;
}

.welcome {
    color: #2563eb;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 42px;
    margin: 15px 0;
    color: #14213d;
}

.hero p {
    max-width: 650px;
    margin: 10px auto;
}

.btn {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 12px 25px;
    margin-top: 20px;
    text-decoration: none;
    border-radius: 6px;
    transition: 0.3s;
}

.btn:hover {
    background: #14213d;
    transform: translateY(-2px);
}

section:not(.hero) {
    padding: 70px 8%;
    text-align: center;
}

section h2 {
    color: #14213d;
    margin-bottom: 18px;
    font-size: 30px;
}

section > p {
    max-width: 750px;
    margin: 0 auto 15px;
}

.cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
}

.card,
.journey-card {
    background: white;
    padding: 28px;
    border-radius: 12px;
    flex: 1 1 220px;
    max-width: 320px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.card:hover,
.journey-card:hover {
    transform: translateY(-6px);
}

.card h3,
.journey-card h3 {
    color: #2563eb;
    margin-bottom: 12px;
}

.timeline {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
}

#journey {
    background: #e5efff;
}

#contact {
    background: white;
}

footer {
    background: #14213d;
    color: white;
    text-align: center;
    padding: 28px;
}

footer p {
    margin: 5px;
}

@media (max-width: 600px) {
    nav {
        flex-direction: column;
    }

    nav ul {
        justify-content: center;
        gap: 12px;
    }

    .hero {
        padding: 75px 20px;
    }

    .hero h1 {
        font-size: 30px;
    }

    section:not(.hero) {
        padding: 50px 6%;
    }

    section h2 {
        font-size: 25px;
    }

    .card,
    .journey-card {
        max-width: 100%;
    }
}
